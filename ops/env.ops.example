# Copy to ops/.env.ops on the SERVER only (git-ignored). Fill every value.
BACKUP_DIR=/home/crux/backups          # local backup root (daily/ and weekly/ created under it)
AVATAR_DIR=/home/crux/crux/uploads/avatars  # host bind mount for user avatar uploads (see docker-compose.yml)
PG_USER=crux
PG_DB=cruxdb
R2_REMOTE=r2:crux-backups              # rclone remote:bucket
HEALTHCHECK_URL=                       # healthchecks.io ping URL for the backup check
