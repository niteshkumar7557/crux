# ─────────────────────────────────────────────────────────────────────────────
# Crux — backend environment
#
# Copy to `.env` and fill in the secrets. Everything here is optional except the
# entries marked REQUIRED: the value shown is the code's default when the
# variable is absent, so a minimal .env still boots (minus the LLM key).
#
# All of these are read in exactly one place — `src/config/index.ts`. The single
# exception is CRUX_SEASON_ZERO; see the Seasons block for why.
#
# The GAME RULES are deliberately NOT here. Score ranges, payouts, the draw
# threshold and the rest are fixed by §21 of docs/game-theory.md, asserted by
# unit tests, and printed to users on /rules — an env var that silently changed
# one would make the product lie. The bottom of this file says where they live.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Used by docker-compose.dev.yml to create the container's database.
POSTGRES_USER=crux
POSTGRES_PASSWORD=secret
POSTGRES_DB=cruxdb

# REQUIRED — the connection string the app itself uses.
DB_URL=postgresql://crux:secret@localhost:5432/cruxdb

# ── Avatar storage ───────────────────────────────────────────────────────────
# Uploaded avatars go to S3-compatible object storage (Cloudflare R2). Leave
# these EMPTY in development: with any one missing, uploads fall back to the
# local disk under backend/public/uploads/avatars, so you can run and contribute
# without an R2 account. The boot log prints which mode is active.
#
# In production all five are required. A container filesystem is discarded on
# every deploy, and the mounted volume that used to solve that forbade replicas,
# made every deploy an interruption, and could not be backed up on the Hobby
# plan. Object storage is durable by default, so no backup job is needed.
#
# The bucket must be publicly readable (avatars are public images) and served
# from R2_AVATAR_PUBLIC_URL. Use a SEPARATE bucket from the backups one, which
# must stay private.
R2_ENDPOINT=
R2_AVATAR_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_AVATAR_PUBLIC_URL=

# ── Server ───────────────────────────────────────────────────────────────────
# Local-dev port. In production the host platform injects PORT, which takes
# precedence over this — so leave SERVER_PORT alone and never set PORT here.
SERVER_PORT=8000
NODE_ENV=development
# Origin allowed by CORS — the frontend's URL.
CLIENT_URL=http://localhost:3000
# pino log level (fatal|error|warn|info|debug|trace).
LOG_LEVEL=info

# ── Observability ────────────────────────────────────────────────────────────
# Sentry DSN for the backend project. Leave empty to disable (dev/CI).
SENTRY_DSN=

# ── Edge verification ────────────────────────────────────────────────────────
# Shared secret proving a request actually came through Cloudflare. Set it here
# AND in a Cloudflare Transform Rule that adds `X-Edge-Secret: <this value>` to
# every proxied request.
#
# Why it exists: Cloudflare overwrites CF-Connecting-IP, so a client cannot forge
# it *past the edge* — but anything reaching the origin directly can set it
# freely, mint a new identity per request, and walk through every rate limit,
# including the 10-per-15-min guard on login. With this set, unverified requests
# instead share one bucket.
#
# Leave EMPTY in dev (no CDN in front, so req.ip is the real client).
EDGE_SECRET=

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED — replace with a long random string before deploying.
JWT_SECRET=supersecret

# Access-token lifetime (any span jsonwebtoken accepts: 15m, 1h, 7d).
ACCESS_TOKEN_TTL=15m
# Refresh-token lifetime, in days.
REFRESH_TOKEN_DAYS=7
# bcrypt cost factor. Higher is slower and safer; 10 is the common floor.
BCRYPT_ROUNDS=10

# ── Google sign-in ───────────────────────────────────────────────────────────
# All three are needed to switch it on. With any one empty the Google routes
# answer 503 and the frontend hides the button entirely, so dev needs no OAuth
# client and the email/password path is unaffected.
#
# Create the client at console.cloud.google.com → APIs & Services → Credentials
# → OAuth client ID → Web application. Scopes are openid, email and profile —
# nothing more, or the app is pushed into Google's verification review.
#
# THE REDIRECT URI GOES THROUGH THE FRONTEND, not the backend's own port. The
# app is same-origin by design: next.config.ts rewrites /api/* to this service,
# so the browser only ever talks to one host and the refresh cookie stays
# sameSite lax. Register BOTH of these as authorised redirect URIs:
#   http://localhost:3000/api/user/auth/google/callback
#   https://<your-domain>/api/user/auth/google/callback
# Leave "Authorised JavaScript origins" empty — the server-side code flow does
# not use them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/user/auth/google/callback

# ── LLM provider ─────────────────────────────────────────────────────────────
# REQUIRED — without a key every AI persona fails and no motion can go live.
# LLM_API_KEY takes precedence; OPENROUTER_API_KEY is kept as an alias.
OPENROUTER_API_KEY=->your_openrouter_api_key_here<-
# LLM_API_KEY=

# Any OpenAI-compatible /chat/completions endpoint. Swapping provider is
# env-only, no code change.
LLM_BASE_URL=https://openrouter.ai/api/v1

# One model drives all six personas — arbiter, both-sides analysis, debater
# description, moderator/analyst, probability, verdict judge. 1M context,
# $0.098 in / $0.196 out per 1M tokens, and a 5x-cheaper cached-input rate that
# the long static system prompts hit on repeat calls.
LLM_MODEL=deepseek/deepseek-v4-flash:nitro

# "off" | "high" | "xhigh". V4 Flash is a reasoning model, and its thinking
# tokens are billed as output AND count toward max_tokens — leaving it on both
# multiplies the bill and truncates the shorter calls into invalid JSON. Every
# persona returns a rubric-scored JSON object, not a derivation, so: off.
LLM_REASONING=off

# Per-request abort, in ms.
LLM_TIMEOUT_MS=30000
# Attempts after the first one fails. ONE, deliberately: the whole chain — the
# LLM call, then the browser's own deadline, then Cloudflare at ~100s — has to
# fit inside 100 seconds, or a post commits while the composer is being told it
# failed. Two retries put the worst case at 90s and lost that race.
LLM_RETRIES=1
LLM_TEMPERATURE=0.2
# Default ceiling for calls that do not set their own. Keep it generous: if
# LLM_REASONING is turned back on, thinking tokens count toward this and a low
# value returns truncated JSON.
LLM_MAX_TOKENS=3000

# ── Seasons ──────────────────────────────────────────────────────────────────
# The launch date, as YYYY-MM-DD. Seasons are numbered from 1 — there is no
# Season 0. Season 1 runs from this instant to the end of the FOLLOWING calendar
# month, so launching part-way through a month does not ship a two-day season;
# every season after it is one clean calendar month, UTC.
#
# SET THIS BEFORE LAUNCH AND NEVER MOVE IT. Season numbers are derived from it
# and written permanently into season_awards.season_number, so changing it later
# silently disagrees with every title already handed out. Anything before this
# date is Season 0 internally, which the rollover job reads as "never award".
#
# This replaces CRUX_SEASON_ZERO, which was a month (YYYY-MM) rather than a date.
# The API refuses to boot if the old name is set and this one is not, so a stale
# value cannot quietly misnumber a season.
#
# Read directly by `src/economy/season.logic.ts` rather than through config —
# it is a pure module, and importing config would pull `dotenv/config` into the
# season unit tests and make them depend on your local .env.
CRUX_LAUNCH_AT=2026-07-31

# ── Telegram relay ("talk to the developer") ─────────────────────────────────
# The website's DM channel: a signed-in user writes from the navbar panel, the
# message is relayed to ONE Telegram chat, and you reply from Telegram — by
# swiping to reply, or by starting a message with `@username`.
#
# BOTH values are needed to switch the relay on. With either empty the poller
# never starts and sends are a no-op, while the web side keeps working in full:
# messages save, the thread renders, unread counts work. So leave these empty in
# dev and the panel is still fully developable. The boot log prints the mode
# (`telegram relay enabled=false`), so a misconfigured production is loud.
#
# Getting the chat id: create the bot with BotFather, send it any message from
# your own account (a bot cannot open a conversation — this step is mandatory),
# then read result[0].message.chat.id from
#   curl https://api.telegram.org/bot<TOKEN>/getUpdates
# Prefer a direct chat with the bot over a broadcast channel: no admin rights to
# grant, and swipe-reply works the same.
#
# SECURITY: getUpdates returns messages from ANYONE who finds the bot, and bot
# usernames are public. Every update from a different chat is dropped before any
# database access — TELEGRAM_DEV_CHAT_ID is what makes that possible, so an
# empty value disables the relay rather than trusting everyone.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEV_CHAT_ID=
# Long-poll hold time, seconds. Telegram's own ceiling is 50. Higher is cheaper:
# one held request replaces many empty ones.
TELEGRAM_POLL_TIMEOUT_S=30

# ── Email (Amazon SES) ───────────────────────────────────────────────────────
# Transactional and notification email: welcome, verdict, reply, new opponent,
# season result, and the operator's announcement about one motion.
#
# FOUR values switch sending on: SES_REGION, the two keys, and SES_FROM_EMAIL.
# With any of them empty the poller never starts, queued rows simply wait in
# email_outbox, and everything else works — so dev and CI need no AWS account.
# The boot log prints `email delivery enabled=false` when it is off.
#
# NOTHING SENDS INLINE. Producers write a row and return; jobs/email.ts drains it
# and re-reads preferences, the suppression list and the ration AT SEND TIME, so
# unsubscribing while a message is queued means it is not sent (§20).
#
# The FROM domain must be a verified SES identity with DKIM. A fresh SES account
# is also sandboxed — 200 messages a day, and only to verified recipients — until
# you request production access, which is a support case, not a setting.
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
SES_FROM_NAME=Crux
# Optional. If set it must be a monitored mailbox — a Reply-To nobody reads is
# worse than none, because it invites replies that vanish.
SES_REPLY_TO=

# Optional, and only needed for the bounce/complaint feed. Create a configuration
# set in SES with an SNS destination for Bounce, Complaint and Delivery, point the
# subscription at https://<your-domain>/api/webhooks/ses, and put the topic ARN
# here. The webhook TRUSTS THIS ARN AND NO OTHER — the endpoint is public and
# unauthenticated because SNS cannot present a credential, so with this empty it
# answers 503 and records nothing.
#
# Leave both empty until you have a public HTTPS URL to subscribe. SES applies its
# own account-level suppression regardless; this feed is our local record, which
# is what lets the poller skip a send and answer "why did I not get that email".
SES_CONFIGURATION_SET=
SES_SNS_TOPIC_ARN=

# ── Background jobs ──────────────────────────────────────────────────────────
# Four in-process pollers. Lower values mean more DB load, not more correctness.
# The Telegram one has no tick knob: it long-polls, so it is paced by
# TELEGRAM_POLL_TIMEOUT_S above rather than by an interval.
# Production runs CONCLUSION_TICK_MS=300000: a debate then concludes within five
# minutes of closing rather than one, which nobody notices, and the process idles
# instead of waking every 60s — billed compute on a metered host.
CONCLUSION_TICK_MS=60000
# Max debates concluded per tick (each costs one LLM call).
CONCLUSION_BATCH=20
FEATURING_TICK_MS=300000
SEASON_ROLLOVER_TICK_MS=3600000
# The email drain. Short, because a verdict email that arrives fifteen seconds
# after the verdict feels immediate and one that arrives five minutes later does
# not. Each tick claims at most EMAIL_BATCH rows with FOR UPDATE SKIP LOCKED.
EMAIL_TICK_MS=15000
EMAIL_BATCH=20

# ── Limits ───────────────────────────────────────────────────────────────────
# Arguments handed to the Verdict Judge. Caps prompt size and cost per verdict.
VERDICT_MAX_ARGUMENTS=40
# Rows returned by the leaderboard endpoints.
LEADERBOARD_ROWS=50
# URLs in the generated sitemap.
SITEMAP_ROWS=5000
# Max avatar upload, in megabytes.
AVATAR_UPLOAD_MB=5
# Concluded debates listed on a profile.
PROFILE_HISTORY_ROWS=10
# Live debates listed on a profile.
PROFILE_LIVE_ROWS=6
# Weeks of the logic ledger charted on a profile.
PROFILE_LEDGER_WEEKS=12
# Max characters in one message to the developer. The composer's counter shows
# it, so raising it here raises what the UI advertises too.
DEV_MESSAGE_MAX_CHARS=1000
# The account the DM panel shows as the developer — its handle and avatar are
# what a user sees replying to them. Must match a row in `users` for the
# portrait to appear; without one the panel shows the handle's initials, which
# is indistinguishable from a broken image — check this first if the DM panel
# shows "ND" instead of a face.
DEV_USERNAME=dev_nitesh

# ── Stress seeder (`npm run db:seed:stress` only) ────────────────────────────
# These defaults generate ~1M motions and ~6M arguments.
SEED_USERS=10000
SEED_MOTIONS=1000000
SEED_MAX_ARGUMENTS=12
SEED_BATCH=1000000

# ─────────────────────────────────────────────────────────────────────────────
# Game rules are not configurable. They live here, and in §21 of the spec:
#
#   src/ai/analyst.logic.ts       score range 1-8, standalone cap 5,
#                                 3 full-value arguments before halving
#   src/ai/verdict.logic.ts       draw margin 5, MVP +25, win +10,
#                                 loss -5, author +5
#   src/jobs/featuring.logic.ts   Main Stage size 4, heat window 6h,
#                                 balance floor
#   src/lib/duplicate.logic.ts    the cross-user repost minimum
#   src/economy/season.logic.ts   one calendar month, UTC
#
# Changing one means changing the spec, the code, its unit test, and the copy
# users are shown — together, on purpose.
# ─────────────────────────────────────────────────────────────────────────────
